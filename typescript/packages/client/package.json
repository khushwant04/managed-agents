{
  "name": "@managed-agents/client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for a managed-agents server. Types are generated from the server's OpenAPI spec.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/generated/schema.d.ts",
      "import": "./dist/generated/schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "openapi-typescript ../../../docs/api/openapi.json --default-non-nullable false -o src/generated/schema.ts",
    "check:generated": "node scripts/check-generated.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vite": "7.3.7"
  }
}
