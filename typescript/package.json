{
  "name": "runhive-typescript",
  "private": true,
  "description": "TypeScript SDK workspace for Runhive (client + optional React hooks).",
  "license": "Apache-2.0",
  "author": "Khushwant Sanwalot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khushwant04/managed-agents.git"
  },
  "homepage": "https://github.com/khushwant04/managed-agents#readme",
  "bugs": "https://github.com/khushwant04/managed-agents/issues",
  "workspaces": [
    "packages/client",
    "packages/react"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "npm run generate --workspace @runhive/client",
    "check:generated": "npm run check:generated --workspace @runhive/client",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run test:integration --workspace @runhive/client"
  },
  "overrides": {
    "vite": "7.3.7"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
