# Copy to the repo root as `.env` (docker compose reads ./.env next to
# docker-compose.yml; it is git-ignored):
#
#   cp deploy/compose/.env.example .env
#
# Every value is optional; unset values fall back to the defaults in
# docker-compose.yml. Values marked DEV ONLY are for a laptop, never production.

# --- Model providers ----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Sandboxes ----------------------------------------------------------------
# e2b (default, needs E2B_API_KEY) | docker | local
# For docker, use the override file instead of only setting this:
#   docker compose -f docker-compose.yml -f deploy/compose/docker-sandbox.yml up
AGENTS_SANDBOX_PROVIDER=e2b
E2B_API_KEY=
# Group owning /var/run/docker.sock (docker-sandbox.yml only): stat -c %g /var/run/docker.sock
# DOCKER_GID=

# --- Platform -----------------------------------------------------------------
# Base64-encoded 32-byte key for secret envelope encryption. The compose
# default is a fixed public DEV ONLY key. Generate one with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# AGENTS_MASTER_KEY=

# Admin API key created at gateway startup (DEV ONLY convenience).
AGENTS_BOOTSTRAP_KEY=ak_dev_admin

AGENTS_PUBLIC_URL=http://localhost:8080
# AGENTS_WORKER_CONCURRENCY=8
# AGENTS_LEASE_SECONDS=30
# AGENTS_IDLE_PAUSE_SECONDS=300
# AGENTS_RATE_LIMIT_PER_MINUTE=600

# --- Object storage (MinIO) ---------------------------------------------------
# DEV ONLY credentials; also used by the services as AWS_ACCESS_KEY_ID/SECRET.
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z

# --- Images and ports ---------------------------------------------------------
# AGENTS_IMAGE=managed-agents-server:dev
# GATEWAY_PORT=8080
# POSTGRES_PORT=5432
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
