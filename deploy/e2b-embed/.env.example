# Runhive + E2B Embed on one host. ./up.sh copies this to .env (git-ignored)
# and fills in every empty secret below on its first run; values you set are kept.

# --- Model providers (set at least one) -----------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Generated by up.sh when empty --------------------------------------------
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
# Base64 32-byte key for secret envelope encryption. Back it up: losing it makes
# stored secrets unreadable.
RUNHIVE_MASTER_KEY=
# Admin API key created on first start (sign in to the dashboard with it).
RUNHIVE_BOOTSTRAP_KEY=
# E2B Embed's team API key, copied from Embed's `ready` service on every run.
E2B_API_KEY=
# How clients reach the API (links, webhook URLs). Defaults to http://<this host's IP>:8080.
RUNHIVE_PUBLIC_URL=

# --- Optional ---------------------------------------------------------------
# Where the containers reach Embed. host.docker.internal is the Docker host;
# set this host's LAN IP if a firewall blocks the docker bridge.
# E2B_HOST=host.docker.internal
# GATEWAY_PORT=8080
# DASHBOARD_PORT=3100
# GATEWAY_BIND=0.0.0.0              # 127.0.0.1 to keep the API on this machine
# DASHBOARD_BIND=0.0.0.0
# MINIO_CONSOLE_PORT=9101           # loopback only
# RUNHIVE_WORKER_CONCURRENCY=8
# RUNHIVE_IDLE_PAUSE_SECONDS=300
# E2B_TEMPLATE_CPU=2
# E2B_TEMPLATE_MEMORY_MB=2048
# Published images instead of local builds (./up.sh --pull):
# RUNHIVE_IMAGE=ghcr.io/khushwant04/runhive-server:0.1.0
# RUNHIVE_DASHBOARD_IMAGE=ghcr.io/khushwant04/runhive-dashboard:0.1.0
